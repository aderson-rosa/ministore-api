{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total de pedidos criados",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [ { "expr": "sum(ministore_orders_placed_total)", "refId": "A" } ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Pedidos criados por minuto",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [ { "expr": "sum(rate(ministore_orders_placed_total[1m])) * 60", "refId": "A", "legendFormat": "pedidos/min" } ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "JVM Memory Used",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [ { "expr": "sum(jvm_memory_used_bytes) by (area)", "refId": "A", "legendFormat": "{{area}}" } ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP requests (rate/s) por rota",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [ { "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (uri)", "refId": "A", "legendFormat": "{{uri}}" } ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["ministore"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
